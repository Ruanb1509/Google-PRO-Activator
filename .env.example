# ─────────────────────────────────────────────────────────────────────────────
# Telegram Digital Store - environment variables
# Copy to .env (local) and configure the same keys in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Nothing here is exposed to the browser (no NEXT_PUBLIC_ variables).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployment (used for webhooks and payment redirects)
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# With Neon via Vercel Marketplace these two are created automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/store
# Direct (non-pooled) connection used only by `prisma migrate`
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/store
# Connections per serverless instance (keep small with a pooled URL)
DATABASE_POOL_MAX=5

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 48+ random chars:          node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HASH_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional: protects GET /api/metrics
METRICS_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @
TELEGRAM_BOT_USERNAME=
# Random string [A-Za-z0-9_-]{16,256}; Telegram sends it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Optional: JSON printed by `npm run bot:set-webhook` (avoids a getMe call on cold starts)
TELEGRAM_BOT_INFO=
# Comma-separated Telegram chat ids that receive alerts (low stock, delivery failures)
ADMIN_ALERT_CHAT_IDS=

# ── Mercado Pago (PIX / BRL) ─────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" of the webhook configured in Mercado Pago → Suas integrações → Webhooks
MERCADOPAGO_WEBHOOK_SECRET=
# Store-controlled e-mail sent as payer (no customer personal data is shared)
MERCADOPAGO_PAYER_EMAIL=

# ── Stripe (international card / USD) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Binance Pay (store credit top-ups) ───────────────────────────────────────
# API key of YOUR Binance account with ONLY "Enable Reading" permission
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Your Binance Pay ID shown to customers
BINANCE_PAY_ID=
BINANCE_API_BASE_URL=https://api.binance.com

# ── Test gateway (local / preview only; ignored when VERCEL_ENV=production) ──
PAYMENTS_MOCK_ENABLED=false
MOCK_WEBHOOK_SECRET=
